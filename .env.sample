# AiNA Works 設定ファイル（サンプル）
# このファイルを .env にコピーして値を入れてください。.env は Git に入れません（本番はサーバー上のみ）。
# コードが読むキーはすべてここに並べています。値の無いキーは「未設定なら機能を止める/省く」動きになります。

# サイト設定
SITE_URL=http://localhost
SITE_NAME=AiNA Works
SITE_DESCRIPTION=AIスクール生と企業をつなぐ、新しいクリエイティブプラットフォーム

# データベース設定（MySQL専用）
DB_HOST=localhost
DB_NAME=aina_works
DB_USER=root
DB_PASS=

# セキュリティ設定（本番環境では必ず変更してください）
SECRET_KEY=change_me_to_a_long_random_string
UPLOAD_MAX_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf

# 管理者（初回ログイン時に一度だけ管理者権限を付与。解除は管理画面で行い、ここからは戻らない）
ADMIN_EMAILS=

# AiNA マイページ API（ログイン認証）
AINA_API_BASE_URL=https://mypage.ai-na.co.jp/api/external
AINA_API_KEY=

# メール送信（PHPMailer / SMTP）
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=AiNA Works

# デバッグ（本番は必ず false。true だとエラー詳細・SQLが画面やJSONに出ます）
DEBUG=false

# DBバックアップ Web起動トークン（GitHub Actions の BACKUP_TRIGGER_TOKEN と同じ値）
# 生成例: php -r "echo bin2hex(random_bytes(32));"
BACKUP_TRIGGER_TOKEN=

# Gemini API（AIディレクター・LINE求人取り込み）
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT=20
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7

# Discord 案件投稿通知（未設定なら通知しない）
DISCORD_WEBHOOK_URL=

# LINE 求人取り込みBot（api/line-webhook.php）
# シークレット未設定の間は受信を拒否します（誰でも案件を作れる状態にしないため）
DEMI_LINE_CHANNEL_SECRET=
DEMI_LINE_CHANNEL_ACCESS_TOKEN=
# 受け付ける送信元（グループID等をカンマ区切り）。空なら全送信元を受け付け、ログに送信元IDを残す
LINE_ALLOWED_SOURCE_IDS=
# Botが案件を投稿するときの依頼者ユーザーIDと既定カテゴリ
LINE_BOT_CLIENT_ID=112
LINE_BOT_DEFAULT_CATEGORY_ID=1
